{
  "name": "index-oblique",
  "version": "0.1.0",
  "private": true,
  "engines": {
    "node": ">=26.12.1 <27"
  },
  "scripts": {
    "dev": "npm run css:build && concurrently --kill-others \"npm:css:watch\" \"next dev\"",
    "build": "npm run css:build && next build",
    "css:build": "tailwindcss -i \"./src/app/(web)/globals.css\" -o ./src/app/tailwind.generated.css --minify",
    "css:watch": "tailwindcss -i \"./src/app/(web)/globals.css\" -o ./src/app/tailwind.generated.css --watch=always",
    "start": "next start",
    "lint": "eslint",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "lucide-react": "^1.23.0",
    "next": "16.4.3",
    "next-themes": "^0.4.6",
    "react": "19.2.4",
    "react-dom": "19.2.4"
  },
  "devDependencies": {
    "@tailwindcss/cli": "^4.3.3",
    "@types/node": "^26.6.5",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "concurrently": "^10.0.6",
    "eslint": "^9",
    "eslint-config-next": "16.4.3",
    "tailwindcss": "^4.3.3",
    "typescript": "^5"
  }
}
